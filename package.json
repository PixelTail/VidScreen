{
  "name": "vid-minecraft-video-screen",
  "version": "0.0.0",
  "private": true,
  "description": "Development tooling for the cross-version Minecraft video-screen project.",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "mcp:install": "npm install --registry=https://registry.npmjs.org --no-audit --no-fund",
    "mcp:versions": "npm ls @mcdxai/minecraft-dev-mcp @plugdev/mcp",
    "setup": "plugdev setup",
    "dev": "plugdev run",
    "dev:server": "plugdev",
    "dev:watch": "plugdev watch"
  },
  "dependencies": {
    "@mcdxai/minecraft-dev-mcp": "1.3.0",
    "@plugdev/mcp": "0.4.0"
  },
  "devDependencies": {
    "@plugdev/cli": "^1.3.0"
  }
}
